{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Refresh dependencies",
            "request": "launch",
            "command": ".\\gradlew --refresh-dependencies"
        },
        {
            "type": "node-terminal",
            "name": "Build",
            "request": "launch",
            "command": ".\\gradlew build"
        },
        {
            "type": "node-terminal",
            "name": "Run Fabric Client",
            "request": "launch",
            "command": ".\\gradlew fabric:runClient"
        },
        {
            "type": "node-terminal",
            "name": "Run NeoForge Client",
            "request": "launch",
            "command": ".\\gradlew neoforge:runClient"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}